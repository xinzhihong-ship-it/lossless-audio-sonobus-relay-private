PUBLIC_DOMAIN=:80 # 容器内 HTTP 站点；公网无备案时通过 19090 访问，不使用公网 80/443
PUBLIC_HTTP_PORT=19090 # 公网浏览器 WebRTC、Web 音频和健康检查入口
ADMIN_HTTP_PORT=19094 # 仅绑定服务器 127.0.0.1；通过 SSH 隧道访问管理员摄像头控制页
PUBLIC_VIDEO_HOST=82.156.228.183 # MediaMTX WebRTC ICE 对外公布的服务器公网 IP
VIDEO_WEBRTC_PORT=19091 # WebRTC ICE 媒体 UDP；云安全组必须放行
VIDEO_RTSP_PORT=19092 # H.264+Opus RTSP 发布/OBS 媒体源 TCP；云安全组必须放行
MEDIA_MTX_API_USERNAME=media-api # 仅容器内 Node 调用 MediaMTX Control API
MEDIA_MTX_API_PASSWORD=replace-with-a-long-random-secret # MediaMTX Control API 强密码；建议 base64url
MEDIA_MUXER_USERNAME=media-muxer # 服务端音视频合流发布账号
MEDIA_MUXER_PASSWORD=replace-with-a-long-random-secret # 服务端合流发布强密码
JWT_SECRET=replace-with-a-long-random-secret # JWT 与摄像头配对密钥加密；必须改成长随机字符串
ADMIN_USERNAME=admin # 服务器 HTTP/API 管理员用户名；不是 SonoBus group 用户名
ADMIN_PASSWORD=replace-with-a-strong-password # 管理员密码；管理页只通过 SSH 隧道访问
POSTGRES_DB=lossless_audio # PostgreSQL 数据库名；一般不用改
POSTGRES_USER=lossless_audio # PostgreSQL 数据库用户名；一般不用改
POSTGRES_PASSWORD=replace-with-a-strong-db-password # PostgreSQL 数据库密码；必须改成强密码
MAX_BYTES_PER_SECOND_PER_CLIENT=52428800 # 单客户端最大上行字节数/秒；默认 50 MB/s
UDP_RELAY_PORT=9000 # SonoBus UDP 音频中继；云安全组必须放行
CONNECTION_SERVER_PORT=10998 # SonoBus Connection Server；云安全组必须放行 TCP/UDP
WEB_BRIDGE_GROUP=web # 现有浏览器音频桥默认群组
WEB_BRIDGE_USERNAME=web-bridge # 系统浏览器音频桥用户名
WEB_BRIDGE_GROUP_PASSWORD= # 固定浏览器音频群组有密码时填写
